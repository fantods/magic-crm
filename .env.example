# API
PORT=3000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173

# Rate limiting (per IP; set RATE_LIMIT_ENABLED=false to disable)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_MAX=300
# RATE_LIMIT_TIME_WINDOW_MS=60000

# Database
DATABASE_URL=postgresql://formless:formless@127.0.0.1:5432/formless

# Integration/e2e tests
# TEST_DATABASE_URL=postgresql://formless:formless@127.0.0.1:5432/formless
# E2E_DATABASE_URL=postgresql://formless:formless@127.0.0.1:5432/formless_e2e

# OpenAI (server-side only; never expose to the browser)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.1
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT_MS=60000

# Web
VITE_API_URL=http://localhost:3000/api/v1
