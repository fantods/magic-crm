{
  "name": "@formless/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@formless/contracts": "workspace:*",
    "@formless/core": "workspace:*",
    "@formless/database": "workspace:*",
    "@formless/openai": "workspace:*",
    "fastify": "^5.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@formless/testing": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "vitest": "^3.0.0"
  }
}
