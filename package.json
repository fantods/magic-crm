{
  "name": "formless",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "tsc -b tsconfig.json && pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:api": "pnpm --filter @formless/contracts build && pnpm --filter @formless/api dev",
    "dev:web": "pnpm --filter @formless/contracts build && pnpm --filter @formless/web dev",
    "db:migrate": "pnpm --filter @formless/database migrate",
    "db:migrate:down": "pnpm --filter @formless/database migrate down",
    "db:migrate:status": "pnpm --filter @formless/database migrate status",
    "db:up": "docker compose up --wait postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down --volumes"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.26.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
